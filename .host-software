# Software-under-test recipe. Each [software "<name>"] stanza is materialized
# locally under software/<name>/ as a bare object store .bare/ with a .git
# gitdir-link file beside it, plus the canonical worktree at
# software/<name>/<branch>/ and any parallel branch worktrees, all gitignored.
# The pin replaces a submodule gitlink as the reproducibility anchor.
[software "vllm"]
	# Migrated software (it predates this host): its release artifacts are built
	# in upstream GPU images this host does not operate, so the reproducibility
	# property is waived by the case decision below rather than met.
	url          = https://github.com/slartibardfast/vllm.git
	pin          = 79378fe6e87687c63ceab9815c68bf027d491868
	worktrees    =
	worktree     = sm75-marlin 3083b8ef92d9cc023a1835ce43e3ef143e2fdef6
	repro-waiver = call/0002

[software "host-lint"]
	# The commit gate. hooks = pre-commit makes --install-hooks copy this
	# component's dispatch script and its binary into .git/hooks here and into
	# every materialized worktree. The artifact hash is the published
	# linux-amd64 release binary (the host install manifest carries it).
	url       = https://github.com/connollydavid/host-lint.git
	pin       = 966259fb2001d0a4f6bdf3ae608ddd1c36c309d0
	worktrees =
	toolchain = 1.95.0
	build     = cargo build --release --locked
	deploy    = host-lint
	artifact  = target/release/host-lint 5ea6e94d17e7a860c9809728eee988f23caffe45e2d958628835fd44271ec645
	hooks     = pre-commit

[software "deep-research-skills"]
	# The Z.ai/ZCode research-skill lane (plan: materialized 2026-09-05).
	# Upstream Weizhena/Deep-Research-skills; the fork carries the additive
	# ZCode edition (skills/research-zcode-en|-zh): fully targeted at Z.ai
	# backends (WebSearch/WebFetch/webReader, Agent-tool parallelism),
	# symmetric international/chinese endpoint option in both editions.
	# No build: install means copying a skills/research-zcode-* tree into
	# ~/.agents/skills/ (skills are discovered at session start).
	url      = https://github.com/connollydavid/Deep-Research-skills.git
	pin      = b375424ef4abdb08dbf054bc98ae96c35b9e52f8
	worktrees =
	worktree  = master b375424ef4abdb08dbf054bc98ae96c35b9e52f8

[software "host-lifecycle"]
	# The lifecycle binary the phases run through. Recorded so the gate can
	# verify the local binary against the published release the same way.
	url       = https://github.com/connollydavid/host-lifecycle.git
	pin       = 66c24d6de0833b8bafc58c5c875ab23b9303c47a
	worktrees =
	toolchain = 1.95.0
	build     = cargo build --release --locked
	deploy    = host-lifecycle
	artifact  = target/release/host-lifecycle bd701a3723211f71787714d32b70c2be2e39a0b1c5ff5c4c4ca44b1baf8192e1
